# Environment configuration for BankVCS 2.0
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-string-at-least-64-chars

# Database URL (SQLite default or PostgreSQL connection string)
# DATABASE_URL=sqlite:///instance/banking.db
DATABASE_URL=postgresql://bankvcs_user:bankvcs_password@localhost:5432/bankvcs_db

# Security & Rate Limiting Engine Options
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT_LIMIT=100
RATELIMIT_AUTH_LIMIT=5
RATELIMIT_FINANCIAL_LIMIT=10
RATELIMIT_ADMIN_LIMIT=30
RATELIMIT_WINDOW_SECONDS=60
TRUSTED_PROXIES_COUNT=1

# Session & HTTPS Security
SESSION_COOKIE_SECURE=True

# Demo / Seed Credentials (Override before executing seed.py in shared environments)
SEED_ADMIN_PASSWORD=ChangeMe_Admin123!
SEED_EMPLOYEE_PASSWORD=ChangeMe_Employee123!
SEED_CUSTOMER_PASSWORD=ChangeMe_Customer123!
